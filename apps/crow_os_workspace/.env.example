# Copy to .env and set a strong unique password before starting Docker.
# Do not commit .env. CROW_AUTH_PASSWORD is required by docker-compose.yml.
CROW_AUTH_REQUIRED=true
CROW_AUTH_USERNAME=crow
CROW_AUTH_PASSWORD=

# Match the ownership of the checked-out repository on the Docker host.
# macOS/Linux: run `id -u` and `id -g` and set these two values.
CROW_UID=1000
CROW_GID=1000

# Keep the published port on loopback. Use an authenticated HTTPS proxy/tunnel for remote access.
CROW_PUBLISH_ADDR=127.0.0.1
CROW_PUBLISH_PORT=8765

# GitHub pull requests and Actions checks (fine-grained token, read-only repository/actions/PR access).
GITHUB_TOKEN=
GH_TOKEN=

# Host Ollama; Docker Desktop and supported Docker Engine hosts resolve host.docker.internal.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=

# Optional external agent backends.
CURSOR_API_KEY=
XAI_API_KEY=
XAI_MODEL=grok-4.7
